# Optional: als .env.local speichern. Standardwerte funktionieren ohne API-Schlüssel.
# MET_USER_AGENT identifiziert das reale Projekt; für eine andere Bereitstellung anpassen.
MET_USER_AGENT="Fly2YouPitch/0.1 (+https://github.com/Jannik440/Hackathon)"

# Öffentlich im Browser sichtbar. Keine Geheimnisse in NEXT_PUBLIC_* speichern.
# Nach Änderungen neu bauen: npm run build
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'
